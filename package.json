{
  "name": "cf-pixel-upscaler",
  "version": "1.0.0",
  "description": "整数倍像素复制放大 CLI（最近邻/像素复制），多核并行、内存安全、实时进度",
  "type": "module",
  "bin": {
    "pixel-upscaler": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pixel",
    "upscale",
    "nearest-neighbor",
    "image",
    "sharp",
    "cli",
    "multithread"
  ],
  "license": "MIT",
  "dependencies": {
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}